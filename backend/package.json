{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate": "ts-node src/scripts/migrate.ts",
    "migrate:undo": "ts-node src/scripts/migrate.ts undo",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:undo": "ts-node src/scripts/seed.ts undo",
    "db:reset": "npm run migrate:undo && npm run migrate && npm run seed",
    "clean-db": "ts-node src/scripts/clean.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/winston": "^2.4.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "nodemon": "^3.1.9",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "sequelize": "^6.37.5",
    "socket.io": "^4.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/umzug": "^2.3.9",
    "@types/uuid": "^10.0.0",
    "umzug": "^3.8.2",
    "uuid": "^11.1.0"
  }
}
